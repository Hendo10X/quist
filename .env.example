# Copy to .env (local) and set the same keys in Vercel → Project → Settings →
# Environment Variables (Production + Preview). Values are NOT committed.

# ── Database: Neon Postgres ───────────────────────────────────────────
# Use the POOLED connection string (…-pooler.…neon.tech) for serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# ── Auth: Better Auth ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Your deployed origin, no trailing slash. Local: http://localhost:3000
BETTER_AUTH_URL="https://your-app.vercel.app"

# GitHub OAuth — callback URL must be: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── AI parsing: Groq (Vercel SDK) ─────────────────────────────────────
GROQ_API_KEY=""

# ── Security: Arcjet ──────────────────────────────────────────────────
ARCJET_KEY=""

# ── Search cache: Upstash Redis (optional — search works without it) ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Email: Resend (optional — only when email verification is re-enabled) ──
RESEND_API_KEY=""
EMAIL_FROM="Quist <noreply@yourdomain.com>"
